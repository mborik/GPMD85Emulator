// Persist /home/web_user (settings) in browser's IndexedDB via IDBFS.
Module.preRun = Module.preRun || [];
Module.preRun.push(function () {
	var dir = '/home/web_user';
	try { FS.mkdirTree(dir); } catch (e) {}
	FS.mount(IDBFS, {}, dir);

	var loaded = false, syncing = false;
	var sync = function () {
		if (!loaded || syncing) return;
		syncing = true;
		FS.syncfs(false, function (err) {
			if (err) console.error('IDBFS save failed:', err);
			syncing = false;
		});
	};

	addRunDependency('idbfs-sync');
	FS.syncfs(true, function (err) {
		if (err) console.error('IDBFS load failed:', err);
		else {
			loaded = true;
			// build changed: drop the stale user config so the bundled default.conf is used
			var verFile = dir + '/.version', stored = '';
			try { stored = FS.readFile(verFile, { encoding: 'utf8' }); } catch (e) {}
			if (stored !== '@PACKAGE_VERSION@.@CONFIGURATION_VERSION@') {
				try { FS.unlink(dir + '/default.conf'); } catch (e) {}
				FS.writeFile(verFile, '@PACKAGE_VERSION@.@CONFIGURATION_VERSION@');
				sync();
			}
		}
		removeRunDependency('idbfs-sync');
	});

	window.addEventListener('beforeunload', function () {
		if (!loaded) return;
		if (Module['autosaveSettings']) Module['autosaveSettings']();
		sync();
	});
	window.addEventListener('pagehide', sync);
	document.addEventListener('visibilitychange', function () { if (document.hidden) sync(); });
	setInterval(sync, 5000);
});
